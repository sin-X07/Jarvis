# Jarvis 配置示例：复制成 .env 再填。
# .env 里有你的 key，绝不要提交到公开仓库（.gitignore 已排除）。

# 必须填：在 https://platform.deepseek.com/api_keys 创建
DEEPSEEK_API_KEY=sk-在这里填你的key

# 模型（默认 deepseek-flash；别填 deepseek-v4.1-1017，那是权重名不是 API id）
DEEPSEEK_MODEL=deepseek-flash
# API 地址，一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 一轮对话里模型最多调几次工具（1–100，默认 10）
AGENT_MAX_STEPS=10
# 单次 API 调用超时（秒，默认 60）
JARVIS_TIMEOUT=60
# 429/超时/5xx 时重试几次（0–10，默认 3，退避 1s→2s→4s）
JARVIS_RETRY_TIMES=3
# run_shell 默认超时（秒，默认 30）
JARVIS_SHELL_TIMEOUT=30
# 权限档位：readonly（只读）/ edit（可改工作区，写操作需确认）/ auto（工作区内自动）
JARVIS_PERMISSION=edit
# 费用上限（美元，0 = 不限；超了循环就停）
JARVIS_MAX_BUDGET_USD=0
# 每日费用提醒（美元，0 = 不提醒）
JARVIS_DAILY_BUDGET_USD=0
# 上下文窗口（token，默认 1M；deepseek-flash 的窗口）
JARVIS_CONTEXT_LIMIT=1000000
